DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/southpaw?sslmode=require
PORT=3000
CORS_ORIGIN=http://localhost:3000
EMAIL_PROVIDER=console
EMAIL_FROM=alerts@southpaw.example
APP_BASE_URL=http://localhost:3000

# The API's own public URL -- used to build the one-click unsubscribe link
# in alert emails. Must point at the API service, not the frontend.
API_BASE_URL=http://localhost:3000

# Random secret used to sign/verify unsubscribe links. Must be the same value
# on the API service and wherever checkAlerts.js runs (GitHub Actions secrets).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
UNSUBSCRIBE_SECRET=

# Only needed if EMAIL_PROVIDER=postmark
POSTMARK_SERVER_TOKEN=

# Only needed if EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=
